<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuAPP.OnboardingPage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView Padding="20,40,20,20">
        <VerticalStackLayout Spacing="25">

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Bienvenido Atleta" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                <Label Text="Ingresa tus datos para calibrar tu campamento" FontSize="14" TextColor="{StaticResource SubtitleColor}" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- TARJETA 1: DATOS BIOMÉTRICOS (Con el estilo de tu perfil) -->
            <Border Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    <Label Text="Identificación" FontSize="16" FontAttributes="Bold" TextColor="White"/>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nombre o Apodo" TextColor="{StaticResource SubtitleColor}" FontSize="12"/>
                        <Entry x:Name="EntryName" Placeholder="Ej. Juan Deportista" BackgroundColor="#27272A" TextColor="White"/>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Edad" TextColor="{StaticResource SubtitleColor}" FontSize="12"/>
                            <Entry x:Name="EntryAge" Keyboard="Numeric" Placeholder="Ej. 18" BackgroundColor="#27272A" TextColor="White"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Altura (cm)" TextColor="{StaticResource SubtitleColor}" FontSize="12"/>
                            <Entry x:Name="EntryHeight" Keyboard="Numeric" Placeholder="Ej. 175" BackgroundColor="#27272A" TextColor="White"/>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Peso actual (kg)" TextColor="{StaticResource SubtitleColor}" FontSize="12"/>
                        <Entry x:Name="EntryWeight" Keyboard="Numeric" Placeholder="Ej. 70.5" BackgroundColor="#27272A" TextColor="White"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- TARJETA 2: EL RELOJ -->
            <Border Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="⏰ Horario de Entrenamiento" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource WorkColor}"/>
                    <Label Text="¿A qué hora sueles empezar? Te avisaremos exactamente 30 minutos antes para que te pongas las vendas." TextColor="{StaticResource SubtitleColor}" FontSize="12"/>
                    <TimePicker x:Name="TpTrainingTime" BackgroundColor="#27272A" TextColor="White" HeightRequest="45"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="INICIAR CAMPAMENTO" Clicked="OnComenzarClicked" BackgroundColor="White" TextColor="Black" FontAttributes="Bold" CornerRadius="10" HeightRequest="55" Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>