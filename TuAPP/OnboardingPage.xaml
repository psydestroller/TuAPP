<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuAPP.OnboardingPage" BackgroundColor="#09090B">

    <VerticalStackLayout VerticalOptions="Center" Spacing="25" Padding="30">
        <Label Text="🥊" FontSize="80" HorizontalOptions="Center"/>
        <Label Text="Bienvenido a tu Campamento" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
        <Label Text="Configura tu perfil para calcular tu categoría y el desgaste calórico exacto." FontSize="14" TextColor="#A1A1AA" HorizontalTextAlignment="Center"/>

        <Border BackgroundColor="#18181B" Padding="20" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Tu nombre" TextColor="#A1A1AA" FontSize="12"/>
                    <Entry x:Name="EntryName" Placeholder="Ej. Pedro" BackgroundColor="#27272A" TextColor="White"/>
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Peso (kg)" TextColor="#A1A1AA" FontSize="12"/>
                        <Entry x:Name="EntryWeight" Keyboard="Numeric" Placeholder="Ej. 66.0" BackgroundColor="#27272A" TextColor="White"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Edad" TextColor="#A1A1AA" FontSize="12"/>
                        <Entry x:Name="EntryAge" Keyboard="Numeric" Placeholder="Ej. 17" BackgroundColor="#27272A" TextColor="White"/>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Button Text="Entrar al Gimnasio" BackgroundColor="#10B981" TextColor="Black" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Clicked="OnStartClicked"/>
    </VerticalStackLayout>
</ContentPage>