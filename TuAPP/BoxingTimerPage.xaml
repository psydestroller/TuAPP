<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TuAPP"
             x:Class="TuAPP.BoxingTimerPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#09090B">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20,40,20,30">

        <VerticalStackLayout Grid.Row="0" Spacing="15" HorizontalOptions="Center">
            <Picker x:Name="PckWorkoutType" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" BackgroundColor="Transparent" Title="Elige Modalidad">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Classic boxing 🥊</x:String>
                        <x:String>Sombra 👤</x:String>
                        <x:String>Costal 🥋</x:String>
                        <x:String>Sparring 🤼</x:String>
                        <x:String>Cuerda ➰</x:String>
                    </x:Array>
                </Picker.ItemsSource>
                <Picker.SelectedIndex>0</Picker.SelectedIndex>
            </Picker>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="40" HorizontalOptions="Center">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="Ejercicio" TextColor="#A1A1AA" FontSize="12" HorizontalOptions="Center"/>
                    <Label x:Name="LblWorkConfig" Text="03:00" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="Descanso" TextColor="#A1A1AA" FontSize="12" HorizontalOptions="Center"/>
                    <Label x:Name="LblRestConfig" Text="00:30" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <Grid Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="320" HeightRequest="320">
            <GraphicsView x:Name="TimerGraphicsView" HorizontalOptions="Fill" VerticalOptions="Fill">
                <GraphicsView.Drawable>
                    <local:CircularProgressDrawable x:Name="TimerDrawable" />
                </GraphicsView.Drawable>
            </GraphicsView>

            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                <Label x:Name="LblStatusTop" Text="LISTO" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,5"/>
                <Label x:Name="LblTimer" Text="03:00" TextColor="White" FontSize="85" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label x:Name="LblRound" Text="Ronda 1/8" TextColor="#A1A1AA" FontSize="16" HorizontalOptions="Center" Margin="0,5,0,0"/>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, Auto" HorizontalOptions="Center" ColumnSpacing="25" VerticalOptions="End">
            <Button Grid.Column="0" Text="↻" Clicked="OnResetClicked" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#18181B" TextColor="White" FontSize="24" VerticalOptions="Center"/>
            <Button Grid.Column="1" x:Name="BtnPlayPause" Text="▶" Clicked="OnPlayPauseClicked" WidthRequest="80" HeightRequest="80" CornerRadius="40" BackgroundColor="#18181B" TextColor="White" FontSize="36" VerticalOptions="Center"/>
            <Button Grid.Column="2" Text="⏭" Clicked="OnSkipClicked" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#18181B" TextColor="White" FontSize="20" VerticalOptions="Center"/>
        </Grid>

    </Grid>
</ContentPage>