<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuAPP.DashboardPage"
             BackgroundColor="#09090B"
             Title="Campamento">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#18181B" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🥊 PRÓXIMA PELEA" FontSize="14" TextColor="#A1A1AA" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label x:Name="LblCountdown" Text="-- Días" FontSize="32" FontAttributes="Bold" TextColor="#EAB308" HorizontalOptions="Center"/>
                    <Label x:Name="LblFightDateDisplay" Text="--" FontSize="14" TextColor="White" HorizontalOptions="Center"/>

                    <BoxView HeightRequest="1" Color="#27272A" Margin="0,15"/>

                    <Grid ColumnDefinitions="*, *">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="5">
                            <Label Text="Peso Actual" FontSize="12" TextColor="#A1A1AA"/>
                            <Label x:Name="LblCurrentWeight" Text="-- kg" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="5">
                            <Label Text="Peso Meta" FontSize="12" TextColor="#A1A1AA"/>
                            <Label x:Name="LblTargetWeight" Text="-- kg" FontSize="20" FontAttributes="Bold" TextColor="#10B981"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#18181B" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📊 RENDIMIENTO SEMANAL" FontSize="14" TextColor="#A1A1AA" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="*, *">
                        <VerticalStackLayout Grid.Column="0">
                            <Label x:Name="LblDailyRounds" Text="0" FontSize="28" FontAttributes="Bold" TextColor="White"/>
                            <Label Text="Rounds Totales" FontSize="12" TextColor="#A1A1AA"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label x:Name="LblDailyCals" Text="0 kcal" FontSize="28" FontAttributes="Bold" TextColor="#EF4444"/>
                            <Label Text="Desgaste Est." FontSize="12" TextColor="#A1A1AA"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#18181B" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="⏰ RECORDATORIO DE ENTRENAMIENTO" FontSize="14" TextColor="#A1A1AA" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15" VerticalOptions="Center">
                        <TimePicker x:Name="TpReminder" Grid.Column="0" TextColor="White" BackgroundColor="#27272A"/>
                        <Button Grid.Column="1" Text="Programar" Clicked="OnScheduleReminderClicked" BackgroundColor="#10B981" TextColor="Black" FontAttributes="Bold"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="SESIONES RECIENTES" FontSize="14" TextColor="#A1A1AA" FontAttributes="Bold" Margin="0,10,0,0"/>
            <CollectionView x:Name="ListGymSessions">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#18181B" Padding="15" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0" Text="{Binding TypeIcon}" FontSize="24" VerticalOptions="Center" Margin="0,0,15,0"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding TypeLabel}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="{Binding Date, StringFormat='{0:dd MMM HH:mm}'}" FontSize="12" TextColor="#A1A1AA"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center">
                                    <Label Text="{Binding RoundsCompleted, StringFormat='{0} Rnds'}" FontSize="14" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="End"/>
                                    <Label Text="{Binding CaloriesBurned, StringFormat='{0:F0} kcal'}" FontSize="12" TextColor="#EF4444" HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>