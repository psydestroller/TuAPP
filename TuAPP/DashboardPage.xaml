<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuAPP.DashboardPage">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">
            <Button Text="⚙️ Metas" Clicked="OnEditGoalsClicked" WidthRequest="100"/>

            <Border StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="#1A1A1A" IsVisible="False" x:Name="FormEditGoals">
                <VerticalStackLayout Spacing="10">
                    <DatePicker x:Name="DpFightDate"/>
                    <Entry x:Name="EntryTargetWeight" Keyboard="Numeric"/>
                    <Button Text="Guardar" Clicked="OnSaveGoalsClicked"/>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="LblFightDateDisplay" TextColor="White"/>
            <Label x:Name="LblCountdown" TextColor="Yellow"/>
            <Label x:Name="LblCurrentWeight" TextColor="White"/>
            <Label x:Name="LblTargetWeight" TextColor="Green"/>

            <Entry x:Name="EntryGymRounds" Placeholder="Rounds"/>
            <Picker x:Name="PckGymType">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Sparring</x:String>
                        <x:String>Costal</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Entry x:Name="EntryGymNotes" Placeholder="Notas"/>
            <Button Text="Guardar Sesión" Clicked="OnSaveGymSession"/>
            <Button Text="Compartir" Clicked="OnShareSession"/>

            <CollectionView x:Name="ListGymSessions"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>