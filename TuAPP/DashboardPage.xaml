<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TuAPP"
             x:Class="TuAPP.DashboardPage" BackgroundColor="#09090B">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">
            <Label Text="Campamento" FontSize="28" FontAttributes="Bold" TextColor="White"/>

            <!-- TARJETA 1: PRÓXIMA PELEA CON BOTÓN DE EDITAR -->
            <Border BackgroundColor="#18181B" Padding="20" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="🥊 PRÓXIMA PELEA" TextColor="#A1A1AA" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="✏️ Editar" FontSize="12" BackgroundColor="#27272A" TextColor="White" HeightRequest="30" CornerRadius="6" Padding="10,0" Clicked="OnToggleEditFight"/>
                    </Grid>

                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label x:Name="LblCountdown" Text="37 días" FontSize="36" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="Center"/>
                        <Label x:Name="LblFightDateDisplay" Text="26 de julio, 2026" TextColor="#A1A1AA" FontSize="14" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- FORMULARIO DESPLEGABLE DE PELEA -->
                    <Border x:Name="FormEditFight" IsVisible="False" BackgroundColor="#27272A" Padding="15" StrokeShape="RoundRectangle 10" StrokeThickness="0" Margin="0,10,0,0">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Modificar Combate" FontAttributes="Bold" TextColor="White" FontSize="14"/>
                            <DatePicker x:Name="DpFightDate" BackgroundColor="#18181B" TextColor="White"/>
                            <Entry x:Name="EntryTargetWeight" Keyboard="Numeric" Placeholder="Peso pactado (kg)" BackgroundColor="#18181B" TextColor="White"/>
                            <Button Text="Guardar Combate" BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" HeightRequest="40" CornerRadius="6" Clicked="OnSaveFight"/>
                        </VerticalStackLayout>
                    </Border>

                    <BoxView HeightRequest="1" Color="#27272A" Margin="0,5"/>

                    <Grid ColumnDefinitions="*, *">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="Peso Actual" TextColor="#A1A1AA" FontSize="12" HorizontalOptions="Center"/>
                            <Label x:Name="LblCurrentWeight" Text="66.5 kg" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="Peso Meta" TextColor="#A1A1AA" FontSize="12" HorizontalOptions="Center"/>
                            <Label x:Name="LblTargetWeight" Text="66.0 kg" TextColor="#10B981" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- TARJETA 2: META SEMANAL -->
            <Border BackgroundColor="#18181B" Padding="20" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                <VerticalStackLayout Spacing="15">
                    <Label Text="📊 META SEMANAL (50 ROUNDS)" TextColor="#A1A1AA" FontSize="12" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="Auto, *">
                        <GraphicsView Grid.Column="0" x:Name="ProgressGraphicsView" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center">
                            <GraphicsView.Drawable>
                                <local:CircularProgressDrawable x:Name="CampProgressDrawable"/>
                            </GraphicsView.Drawable>
                        </GraphicsView>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                            <Label x:Name="LblDailyCals" Text="~0 kcal" TextColor="#EF4444" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="Desgaste Est." TextColor="#A1A1AA" FontSize="12" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- SESIONES RECIENTES -->
            <VerticalStackLayout Spacing="10">
                <Label Text="SESIONES RECIENTES" TextColor="#A1A1AA" FontSize="12" FontAttributes="Bold" Margin="5,10,0,0"/>
                <CollectionView x:Name="ListGymSessions">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#18181B" Padding="15" Margin="0,0,0,10" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Type}" TextColor="White" FontAttributes="Bold" FontSize="16"/>
                                        <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}" TextColor="#A1A1AA" FontSize="12"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding RoundsCompleted, StringFormat='{0} Rnds'}" TextColor="#10B981" FontAttributes="Bold" FontSize="16" HorizontalOptions="End"/>
                                        <Label Text="{Binding CaloriesBurned, StringFormat='{0:F0} kcal'}" TextColor="#EF4444" FontSize="12" HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>