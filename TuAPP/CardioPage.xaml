<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuAPP.CardioPage"
             BackgroundColor="#09090B">

    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="15">
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="Cardio" FontSize="28" FontAttributes="Bold" TextColor="White"/>
                <Button Grid.Column="1" x:Name="BtnAgregar" Text="+ Agregar" Clicked="OnToggleFormClicked" BackgroundColor="#18181B" TextColor="White" CornerRadius="8" HeightRequest="40"/>
            </Grid>
            <Label Text="Historial de carreras" TextColor="#A1A1AA" Margin="0,-10,0,0"/>

            <Border BackgroundColor="#18181B" Padding="20" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                <Grid ColumnDefinitions="*,*,*">
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                        <Label Text="Total km" TextColor="#A1A1AA" FontSize="12" HorizontalOptions="Center"/>
                        <Label x:Name="LblTotalKm" Text="0" TextColor="#10B981" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label Text="Sesiones" TextColor="#A1A1AA" FontSize="12" HorizontalOptions="Center"/>
                        <Label x:Name="LblTotalSes" Text="0" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                        <Label Text="Ritmo prom." TextColor="#A1A1AA" FontSize="12" HorizontalOptions="Center"/>
                        <Label x:Name="LblAvgPace" Text="0:00" TextColor="#EAB308" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border BackgroundColor="#18181B" Padding="15" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Últimas sesiones (km)" TextColor="#A1A1AA" FontSize="12"/>
                    <Grid x:Name="ChartGrid" HeightRequest="80" ColumnSpacing="5" VerticalOptions="End"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" x:Name="FormAdd" IsVisible="False" Padding="20,10">
            <VerticalStackLayout Spacing="15">
                <Label Text="Nueva sesión" TextColor="White" FontAttributes="Bold"/>
                <DatePicker x:Name="DpDate" BackgroundColor="#18181B" TextColor="White"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <Entry Grid.Column="0" x:Name="EntryKm" Placeholder="Distancia (km)" Keyboard="Numeric" BackgroundColor="#18181B" TextColor="White"/>
                    <Entry Grid.Column="1" x:Name="EntryMin" Placeholder="Tiempo (min)" Keyboard="Numeric" BackgroundColor="#18181B" TextColor="White"/>
                </Grid>
                <Entry x:Name="EntryNotes" Placeholder="Notas (opcional)" BackgroundColor="#18181B" TextColor="White"/>
                <Button Text="Guardar Carrera" Clicked="OnSaveLog" BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" x:Name="ViewHistory">
            <CollectionView x:Name="ListCardio" Margin="20,0,20,20">

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,50,0,0">
                        <Label Text="🏃" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="Sin carreras registradas" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Toca + Agregar para empezar tu historial." TextColor="#A1A1AA" FontSize="14" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#18181B" Margin="0,0,0,10" Padding="15" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Date}" TextColor="#A1A1AA" FontSize="12"/>
                                    <Label Text="{Binding Info}" TextColor="White" FontSize="14" FontAttributes="Bold" Margin="0,2,0,0"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                                    <Label Text="{Binding Dist}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="End"/>
                                    <Border BackgroundColor="#064E3B" Padding="6,2" StrokeShape="RoundRectangle 4" StrokeThickness="0" HorizontalOptions="End" Margin="0,2,0,0">
                                        <Label Text="{Binding Pace}" TextColor="#10B981" FontSize="10" FontAttributes="Bold"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </Grid>
</ContentPage>