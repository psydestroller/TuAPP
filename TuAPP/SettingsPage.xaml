<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuAPP.SettingsPage" 
             BackgroundColor="{StaticResource BackgroundColor}">

    <!-- ENVOLVEMOS TODO EN UN GRID PARA PODER PONER EL MENÚ FLOTANTE ENCIMA -->
    <Grid>

        <!-- TU CONTENIDO ORIGINAL -->
        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="25">
                <Label Text="Ajustes" FontSize="26" FontAttributes="Bold" TextColor="White"/>

                <Label Text="CONFIGURACIÓN DEL PERFIL (BOXEO CLÁSICO)" FontSize="12" TextColor="{StaticResource AccentColor}" FontAttributes="Bold"/>
                <Border Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Cantidad de rondas" TextColor="White" VerticalOptions="Center"/>
                            <Picker x:Name="PckRounds" Grid.Column="1" WidthRequest="70" TextColor="White" TitleColor="White" BackgroundColor="#27272A" HorizontalTextAlignment="Center" SelectedIndexChanged="OnSettingsChanged"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#27272A"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Tiempo de la ronda" TextColor="White" VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                <Picker x:Name="PckWorkMin" WidthRequest="60" TextColor="White" TitleColor="White" BackgroundColor="#27272A" HorizontalTextAlignment="Center" SelectedIndexChanged="OnSettingsChanged"/>
                                <Label Text=":" VerticalOptions="Center" TextColor="White"/>
                                <Picker x:Name="PckWorkSec" WidthRequest="60" TextColor="White" TitleColor="White" BackgroundColor="#27272A" HorizontalTextAlignment="Center" SelectedIndexChanged="OnSettingsChanged"/>
                            </HorizontalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#27272A"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Tiempo del descanso" TextColor="White" VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                <Picker x:Name="PckRestMin" WidthRequest="60" TextColor="White" TitleColor="White" BackgroundColor="#27272A" HorizontalTextAlignment="Center" SelectedIndexChanged="OnSettingsChanged"/>
                                <Label Text=":" VerticalOptions="Center" TextColor="White"/>
                                <Picker x:Name="PckRestSec" WidthRequest="60" TextColor="White" TitleColor="White" BackgroundColor="#27272A" HorizontalTextAlignment="Center" SelectedIndexChanged="OnSettingsChanged"/>
                            </HorizontalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#27272A"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Tiempo de preparación" TextColor="White" VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                <Picker x:Name="PckPrepMin" WidthRequest="60" TextColor="White" TitleColor="White" BackgroundColor="#27272A" HorizontalTextAlignment="Center" SelectedIndexChanged="OnSettingsChanged"/>
                                <Label Text=":" VerticalOptions="Center" TextColor="White"/>
                                <Picker x:Name="PckPrepSec" WidthRequest="60" TextColor="White" TitleColor="White" BackgroundColor="#27272A" HorizontalTextAlignment="Center" SelectedIndexChanged="OnSettingsChanged"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="SONIDO Y VIBRACIÓN" FontSize="12" TextColor="{StaticResource AccentColor}" FontAttributes="Bold"/>
                <Border Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Campana al inicio/fin" TextColor="White" VerticalOptions="Center"/>
                            <Switch x:Name="SwSound" Grid.Column="1" OnColor="{StaticResource WorkColor}" Toggled="OnTogglesChanged"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#27272A"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Vibración" TextColor="White" VerticalOptions="Center"/>
                            <Switch x:Name="SwVib" Grid.Column="1" OnColor="{StaticResource WorkColor}" Toggled="OnTogglesChanged"/>
                        </Grid>

                        <Label Text="SONIDOS DE CRONOMETRO" FontSize="12" TextColor="{StaticResource AccentColor}" FontAttributes="Bold" Margin="0,10,0,0"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Sonido: Preparación" TextColor="White" VerticalOptions="Center"/>
                            <Button x:Name="BtnSoundPrep" Grid.Column="1" BackgroundColor="#18181B" TextColor="{StaticResource WorkColor}" Clicked="OnOpenMenuClicked" CommandParameter="Prep" Padding="10,5" CornerRadius="5"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Sonido: Inicio de Round" TextColor="White" VerticalOptions="Center"/>
                            <Button x:Name="BtnSoundRoundStart" Grid.Column="1" BackgroundColor="#18181B" TextColor="{StaticResource WorkColor}" Clicked="OnOpenMenuClicked" CommandParameter="Start" Padding="10,5" CornerRadius="5"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Sonido: Aviso 10 Segundos" TextColor="White" VerticalOptions="Center"/>
                            <Button x:Name="BtnSound10Sec" Grid.Column="1" BackgroundColor="#18181B" TextColor="{StaticResource WorkColor}" Clicked="OnOpenMenuClicked" CommandParameter="10Sec" Padding="10,5" CornerRadius="5"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Sonido: Fin de Round / Descanso" TextColor="White" VerticalOptions="Center"/>
                            <Button x:Name="BtnSoundRoundEnd" Grid.Column="1" BackgroundColor="#18181B" TextColor="{StaticResource WorkColor}" Clicked="OnOpenMenuClicked" CommandParameter="End" Padding="10,5" CornerRadius="5"/>
                        </Grid>

                        <!-- SECCIÓN: SONIDOS DE SPRINTS -->
                        <Label Text="SONIDOS DE SPRINTS" FontSize="12" TextColor="{StaticResource AccentColor}" FontAttributes="Bold" Margin="0,15,0,0"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Sonido: Inicio de Preparación" TextColor="White" VerticalOptions="Center"/>
                            <Button x:Name="BtnSoundSprintPrep" Grid.Column="1" BackgroundColor="#18181B" TextColor="{StaticResource WorkColor}" Clicked="OnOpenMenuClicked" CommandParameter="SprintPrep" Padding="10,5" CornerRadius="5"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Sonido: ¡A Correr! (Sprint)" TextColor="White" VerticalOptions="Center"/>
                            <Button x:Name="BtnSoundSprintWork" Grid.Column="1" BackgroundColor="#18181B" TextColor="{StaticResource WorkColor}" Clicked="OnOpenMenuClicked" CommandParameter="SprintWork" Padding="10,5" CornerRadius="5"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Sonido: Recuperación" TextColor="White" VerticalOptions="Center"/>
                            <Button x:Name="BtnSoundSprintRest" Grid.Column="1" BackgroundColor="#18181B" TextColor="{StaticResource WorkColor}" Clicked="OnOpenMenuClicked" CommandParameter="SprintRest" Padding="10,5" CornerRadius="5"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Sonido: Fin del Entrenamiento" TextColor="White" VerticalOptions="Center"/>
                            <Button x:Name="BtnSoundSprintEnd" Grid.Column="1" BackgroundColor="#18181B" TextColor="{StaticResource WorkColor}" Clicked="OnOpenMenuClicked" CommandParameter="SprintEnd" Padding="10,5" CornerRadius="5"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- APARTADO BLINDADO: RECORDATORIO CON BOTONES ACTIVAR / DESACTIVAR -->
                <Label Text="RECORDATORIO DIARIO" FontSize="12" TextColor="{StaticResource AccentColor}" FontAttributes="Bold"/>
                <Border Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="¿A qué hora entrenas? Te avisaremos 30 min antes:" TextColor="{StaticResource SubtitleColor}" FontSize="12"/>
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                            <TimePicker Grid.Column="0" x:Name="TpReminder" BackgroundColor="#27272A" TextColor="White" HeightRequest="40" FontAttributes="Bold"/>
                            <Button Grid.Column="1" Text="Activar" BackgroundColor="{StaticResource WorkColor}" TextColor="Black" FontAttributes="Bold" CornerRadius="6" Padding="15,0" Clicked="OnSaveReminder"/>
                            <Button Grid.Column="2" Text="Desactivar" BackgroundColor="#EF4444" TextColor="White" FontAttributes="Bold" CornerRadius="6" Padding="15,0" Clicked="OnCancelReminder"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="PANTALLA" FontSize="12" TextColor="{StaticResource AccentColor}" FontAttributes="Bold"/>
                <Border Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout>
                            <Label Text="Mantener pantalla encendida" TextColor="White" FontAttributes="Bold"/>
                            <Label Text="Activo durante entrenamientos" TextColor="{StaticResource SubtitleColor}" FontSize="12"/>
                        </VerticalStackLayout>
                        <Switch x:Name="SwScreen" Grid.Column="1" OnColor="{StaticResource WorkColor}" Toggled="OnTogglesChanged"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- EL MENÚ FLOTANTE OSCURO -->
        <Grid x:Name="MenuSonidosOverlay" IsVisible="False" BackgroundColor="#B3000000">
            <Border BackgroundColor="#27272A" Padding="20" WidthRequest="320" HorizontalOptions="Center" VerticalOptions="Center" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="15">

                    <Label x:Name="LblMenuTitle" Text="Selecciona un sonido" TextColor="White" FontAttributes="Bold" FontSize="18" />

                    <!-- Lista de opciones -->
                    <CollectionView x:Name="CvSonidos" SelectionMode="Single" SelectionChanged="OnSonidoSeleccionado" HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="15,12">
                                    <Label Text="{Binding .}" TextColor="White" VerticalOptions="Center" FontSize="16"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Botón OK -->
                    <Button Text="OK" TextColor="{StaticResource WorkColor}" BackgroundColor="Transparent" HorizontalOptions="End" Clicked="OnOkClicked" FontAttributes="Bold" FontSize="16" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>