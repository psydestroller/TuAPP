<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuAPP.SprintsPage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,30" Spacing="20">
            <Label Text="Sprints" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>

            <Border Background="{StaticResource CardBackground}" Stroke="Transparent" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Preparación" VerticalOptions="Center" FontSize="16" TextColor="{StaticResource PrepColor}"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="5">
                            <Picker x:Name="PckPrepMin" Title="Min" WidthRequest="65" TextColor="White" TitleColor="White" BackgroundColor="Transparent"/>
                            <Label Text=":" VerticalOptions="Center" TextColor="White" FontAttributes="Bold"/>
                            <Picker x:Name="PckPrepSec" Title="Seg" WidthRequest="65" TextColor="White" TitleColor="White" BackgroundColor="Transparent"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#333333" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Tiempo de Sprint" VerticalOptions="Center" FontSize="16" TextColor="{StaticResource WorkColor}"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="5">
                            <Picker x:Name="PckWorkMin" Title="Min" WidthRequest="65" TextColor="White" TitleColor="White" BackgroundColor="Transparent"/>
                            <Label Text=":" VerticalOptions="Center" TextColor="White" FontAttributes="Bold"/>
                            <Picker x:Name="PckWorkSec" Title="Seg" WidthRequest="65" TextColor="White" TitleColor="White" BackgroundColor="Transparent"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#333333" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Recuperación" VerticalOptions="Center" FontSize="16" TextColor="{StaticResource RestColor}"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="5">
                            <Picker x:Name="PckRestMin" Title="Min" WidthRequest="65" TextColor="White" TitleColor="White" BackgroundColor="Transparent"/>
                            <Label Text=":" VerticalOptions="Center" TextColor="White" FontAttributes="Bold"/>
                            <Picker x:Name="PckRestSec" Title="Seg" WidthRequest="65" TextColor="White" TitleColor="White" BackgroundColor="Transparent"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#333333" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Número de Sprints" VerticalOptions="Center" FontSize="16" TextColor="White"/>
                        <Picker x:Name="PckSets" Title="Sets" Grid.Column="1" WidthRequest="80" TextColor="White" TitleColor="White" BackgroundColor="Transparent" HorizontalTextAlignment="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="LblSprintTimer" Text="00:00" FontSize="100" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource WorkColor}" Margin="0,20,0,0"/>
            <Label x:Name="LblSprintStatus" Text="LISTO" FontSize="20" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" Margin="0,30,0,0">
                <Button Text="🔄" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#1E1E1E" TextColor="White" FontSize="20" Clicked="OnResetClicked"/>
                <Button x:Name="BtnStartSprints" Text="INICIAR" WidthRequest="150" HeightRequest="60" CornerRadius="30" BackgroundColor="{StaticResource WorkColor}" TextColor="Black" FontAttributes="Bold" FontSize="18" Clicked="OnStartSprintsClicked"/>
                <Button Text="⏭" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#1E1E1E" TextColor="White" FontSize="20" Clicked="OnSkipClicked"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>