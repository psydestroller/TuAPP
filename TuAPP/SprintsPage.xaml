<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
             x:Class="TuAPP.SprintsPage"
             BackgroundColor="{StaticResource BackgroundColor}">
   
    <ScrollView>
        
        <VerticalStackLayout Padding="25,0,25,9" Spacing="18">
            <admob:BannerAd
Grid.Row="0"
AdUnitId="ca-app-pub-5227773888709145/4329609279"
    AdSize="FullBanner"
    HorizontalOptions="Fill"
Margin="0,0,0,0"
HeightRequest="60" />

            <Label Text="Sprints" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>

            <Border Background="{StaticResource CardBackground}" Stroke="Transparent" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Preparación" VerticalOptions="Center" FontSize="16" TextColor="{StaticResource PrepColor}"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="5">
                            <Picker x:Name="PckPrepMin" Title="Min" WidthRequest="65" TextColor="White" TitleColor="White" BackgroundColor="Transparent" SelectedIndexChanged="OnSprintConfigChanged"/>
                            <Label Text=":" VerticalOptions="Center" TextColor="White" FontAttributes="Bold"/>
                            <Picker x:Name="PckPrepSec" Title="Seg" WidthRequest="65" TextColor="White" TitleColor="White" BackgroundColor="Transparent" SelectedIndexChanged="OnSprintConfigChanged"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#333333" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Tiempo de Sprint" VerticalOptions="Center" FontSize="16" TextColor="{StaticResource WorkColor}"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="5">
                            <Picker x:Name="PckWorkMin" Title="Min" WidthRequest="65" TextColor="White" TitleColor="White" BackgroundColor="Transparent" SelectedIndexChanged="OnSprintConfigChanged"/>
                            <Label Text=":" VerticalOptions="Center" TextColor="White" FontAttributes="Bold"/>
                            <Picker x:Name="PckWorkSec" Title="Seg" WidthRequest="65" TextColor="White" TitleColor="White" BackgroundColor="Transparent" SelectedIndexChanged="OnSprintConfigChanged"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#333333" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Recuperación" VerticalOptions="Center" FontSize="16" TextColor="{StaticResource RestColor}"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="5">
                            <Picker x:Name="PckRestMin" Title="Min" WidthRequest="65" TextColor="White" TitleColor="White" BackgroundColor="Transparent" SelectedIndexChanged="OnSprintConfigChanged"/>
                            <Label Text=":" VerticalOptions="Center" TextColor="White" FontAttributes="Bold"/>
                            <Picker x:Name="PckRestSec" Title="Seg" WidthRequest="65" TextColor="White" TitleColor="White" BackgroundColor="Transparent" SelectedIndexChanged="OnSprintConfigChanged"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#333333" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Número de Sprints" VerticalOptions="Center" FontSize="16" TextColor="White"/>
                        <Picker x:Name="PckSets" Title="Sets" Grid.Column="1" WidthRequest="80" TextColor="White" TitleColor="White" BackgroundColor="Transparent" HorizontalTextAlignment="Center" SelectedIndexChanged="OnSprintConfigChanged"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="LblSprintTimer" Text="00:00" FontSize="100" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource WorkColor}" Margin="0,20,0,0"/>
            <Label x:Name="LblSprintStatus" Text="LISTO" FontSize="20" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" Margin="0,30,0,0">
                <ImageButton Source="ic_reset.png" Clicked="OnResetClicked" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#18181B" Padding="15" VerticalOptions="Center"/>
                <Button x:Name="BtnStartSprints" Text="INICIAR" WidthRequest="150" HeightRequest="60" CornerRadius="30" BackgroundColor="{StaticResource WorkColor}" TextColor="Black" FontAttributes="Bold" FontSize="18" Clicked="OnStartSprintsClicked" VerticalOptions="Center"/>
                <ImageButton Source="ic_skip.png" Clicked="OnSkipClicked" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#18181B" Padding="15" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>