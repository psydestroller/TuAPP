<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TuAPP.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TuAPP"
    Shell.FlyoutBehavior="Flyout"
    BackgroundColor="#09090B"
    FlyoutBackgroundColor="#18181B"
    Title="Campamento">

    <FlyoutItem Title="Principal" FlyoutDisplayOptions="AsMultipleItems">
        <Tab Title="Campamento" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate local:DashboardPage}" />
        </Tab>
        <Tab Title="Entrenar" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate local:BoxingTimerPage}" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Acondicionamiento">
        <ShellContent Title="Sprints" ContentTemplate="{DataTemplate local:SprintsPage}" />
        <ShellContent Title="Cardio" ContentTemplate="{DataTemplate local:CardioPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Mediciones">
        <ShellContent Title="Calculadora IMC" ContentTemplate="{DataTemplate local:IMCpage}" />
        <ShellContent Title="Mi Perfil" ContentTemplate="{DataTemplate local:ProfilePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Configuración">
        <ShellContent Title="Ajustes de App" ContentTemplate="{DataTemplate local:SettingsPage}" />
    </FlyoutItem>

</Shell>