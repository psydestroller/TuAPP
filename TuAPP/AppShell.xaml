<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TuAPP.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TuAPP"
    Shell.FlyoutBehavior="Disabled"
    BackgroundColor="#09090B"
    TabBarBackgroundColor="#09090B"
    TabBarTitleColor="White"
    TabBarUnselectedColor="#A1A1AA">

    <TabBar>
        <Tab Title="Cronómetro" Icon="cronometro.png">
            <ShellContent ContentTemplate="{DataTemplate local:BoxingTimerPage}" />
        </Tab>

        <Tab Title="Sprints" Icon="sprints.png">
            <ShellContent ContentTemplate="{DataTemplate local:SprintsPage}" />
        </Tab>

        <Tab Title="IMC" Icon="imc.png">
            <ShellContent ContentTemplate="{DataTemplate local:IMCpage}" />
        </Tab>

        <Tab Title="Registro" Icon="preparacion.png">
            <ShellContent ContentTemplate="{DataTemplate local:DashboardPage}" />
        </Tab>

        <Tab Title="Perfil" Icon="perfil.png">
            <ShellContent ContentTemplate="{DataTemplate local:ProfilePage}" />
        </Tab>

        <Tab Title="Ajustes" Icon="configuracion.png">
            <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>