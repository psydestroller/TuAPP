<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuAPP.WorkoutSummaryPage"
             BackgroundColor="#09090B">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

        <Label Text="🥊 ¡ENTRENAMIENTO TERMINADO!" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#EAB308"/>

        <Border StrokeShape="RoundRectangle 16" BackgroundColor="#18181B" Padding="25">
            <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                <Label x:Name="LblType" Text="SPARRING" FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                <BoxView HeightRequest="1" Color="#27272A" WidthRequest="150"/>

                <Label x:Name="LblRounds" Text="12 Rounds" FontSize="36" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="Center"/>
                <Label x:Name="LblCalories" Text="-- kcal" FontSize="22" FontAttributes="Bold" TextColor="#EF4444" HorizontalOptions="Center"/>
                <Label x:Name="LblTime" Text="--:--" FontSize="16" TextColor="#A1A1AA" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Spacing="12" Margin="0,10,0,0">
            <Button Text="📲 COMPARTIR EN MIS REDES" Clicked="OnShareClicked" BackgroundColor="#C084FC" TextColor="Black" FontAttributes="Bold" HeightRequest="60" CornerRadius="12"/>
            <Button Text="Cerrar y Volver" Clicked="OnCloseClicked" BackgroundColor="#27272A" TextColor="White" HeightRequest="50" CornerRadius="12"/>
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>